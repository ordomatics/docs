---
// Silent looping tutorial clip from public/editeur/, recorded by
// scripts/tutorial.
interface Props {
	src: string;
	caption?: string;
}
const { src, caption } = Astro.props;
---

<figure class="clip">
	<video src={`/editeur/${src}`} autoplay loop muted playsinline controls preload="metadata"></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.clip {
		margin: 1.25rem 0;
	}
	.clip video {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.clip figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
