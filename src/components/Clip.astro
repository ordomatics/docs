---
// Tutorial clip from public/editeur/, recorded by scripts/tutorial: silent and
// looping, or (voice) a clip with a voice-over the reader starts themselves.
// Each clip has its own anchor, which the share buttons link to.
import ShareBar from "./ShareBar.astro";

interface Props {
	src: string;
	caption?: string;
	voice?: boolean;
}
const { src, caption, voice = false } = Astro.props;

const name = src.split("/").pop()!.replace(/\.mp4$/, "");
const id = `clip-${name}`;
const fr = Astro.url.pathname.startsWith("/fr/");
// Shared as the video's own page (src/pages/v/…): it carries this video's
// preview image for social apps, then sends people on to #id here.
const link = new URL(`/v/${fr ? "fr" : "en"}/${name}/`, Astro.site ?? Astro.url).href;
const title = caption ?? (fr ? "Tutoriel de l'éditeur Smartacus" : "Smartacus editor tutorial");
---

<figure class="clip" id={id}>
	{voice ? (
		<video src={`/editeur/${src}`} playsinline controls preload="metadata"></video>
	) : (
		<video src={`/editeur/${src}`} autoplay loop muted playsinline controls preload="metadata"></video>
	)}
	{caption && <figcaption>{caption}</figcaption>}
	<ShareBar compact link={link} title={title} fr={fr} label={fr ? "Partager cette vidéo" : "Share this video"} />
</figure>

<style>
	.clip {
		margin: 1.25rem 0;
		scroll-margin-top: 5rem;
	}
	.clip video {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.clip figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
