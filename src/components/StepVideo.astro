---
// A recorded clip from public/<dir>/ (getting-started by default), made by scripts/.
// It never autoplays: the reader starts it.
interface Props {
	src: string;
	caption?: string;
	dir?: string;
}
const { src, caption, dir = "getting-started" } = Astro.props;
const id = `video-${src.replace(/\.mp4$/, "")}`;
---

<figure class="step-video" id={id}>
	<video src={`/${dir}/${src}`} playsinline controls preload="metadata"></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.step-video {
		margin: 1.25rem 0;
		scroll-margin-top: 5rem;
	}
	.step-video video {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.step-video figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
