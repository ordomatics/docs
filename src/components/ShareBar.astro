---
// Share buttons (WhatsApp, Facebook, X, LinkedIn, copy link, and the phone's
// share sheet where available) for one link: a tutorial video or a page.
// compact: a single "Share" button that opens the phone's share sheet, or on
// desktop a small panel with the same buttons.
import { Icon } from "@astrojs/starlight/components";

// WhatsApp mark from Simple Icons (CC0); Starlight's icon set has no WhatsApp.
const WHATSAPP = "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z";

interface Props {
	link: string;
	title: string;
	fr: boolean;
	label: string;
	compact?: boolean;
}
const { link, title, fr, label, compact = false } = Astro.props;
const text = encodeURIComponent(`${title} — ${link}`);
const url = encodeURIComponent(link);
const panelId = `share-${link.replace(/^https?:\/\/[^/]+/, "").replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;
const t = fr
	? { share: "Partager", on: "Partager sur", copy: "Copier le lien", copied: "Lien copié" }
	: { share: "Share", on: "Share on", copy: "Copy link", copied: "Link copied" };
const networks = [
	{ name: "WhatsApp", color: "#25D366", href: `https://wa.me/?text=${text}` },
	{ name: "Facebook", icon: "facebook", color: "#0866FF", href: `https://www.facebook.com/sharer/sharer.php?u=${url}` },
	{ name: "X", icon: "x.com", color: "var(--sl-color-white)", href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${url}` },
	{ name: "LinkedIn", icon: "linkedin", color: "#0A66C2", href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}` },
] as const;
const shareIcon = `<svg viewBox="0 0 24 24" width="1.1rem" height="1.1rem" fill="none" stroke="currentColor" stroke-width="2"
	stroke-linecap="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" />
	<circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>`;
---

<div class:list={["clip-share", { "is-compact": compact }]} data-link={link} data-title={title}>
	{compact ? (
		<button type="button" class="clip-share-toggle" aria-expanded="false" aria-controls={panelId}>
			<Fragment set:html={shareIcon} /><span>{t.share}</span>
		</button>
	) : (
		<span class="clip-share-label">{t.share}</span>
	)}
	<div class="clip-share-items" id={panelId} role="group" aria-label={label} hidden={compact}>
		{networks.map((n) => (
			<a href={n.href} target="_blank" rel="noopener noreferrer" title={`${t.on} ${n.name}`}
				aria-label={`${t.on} ${n.name}`} style={`--brand: ${n.color}`}>
				{"icon" in n ? (
					<Icon name={n.icon} size="1.1rem" />
				) : (
					<svg viewBox="0 0 24 24" width="1.1rem" height="1.1rem" fill="currentColor" aria-hidden="true"><path d={WHATSAPP} /></svg>
				)}
			</a>
		))}
		<button type="button" class="clip-share-copy" title={t.copy} aria-label={t.copy} data-copied={t.copied}>
			<Icon name="link" size="1.1rem" />
		</button>
		{!compact && (
			<button type="button" class="clip-share-native" title={t.share} aria-label={t.share} hidden>
				<Fragment set:html={shareIcon} />
			</button>
		)}
		<span class="clip-share-status" role="status"></span>
	</div>
</div>

<script>
	// Phones (coarse pointer + Web Share) get their own share sheet; elsewhere
	// the compact button opens the panel of buttons.
	const phoneShare = () => !!navigator.share && matchMedia("(pointer: coarse)").matches;
	for (const bar of document.querySelectorAll<HTMLElement>(".clip-share")) {
		const link = bar.dataset.link!;
		const share = () => navigator.share({ title: bar.dataset.title, url: link }).catch(() => {});
		const native = bar.querySelector<HTMLButtonElement>(".clip-share-native");
		if (native && navigator.share) {
			native.hidden = false;
			native.addEventListener("click", share);
		}
		const toggle = bar.querySelector<HTMLButtonElement>(".clip-share-toggle");
		const panel = bar.querySelector<HTMLElement>(".clip-share-items")!;
		if (toggle) {
			const setOpen = (open: boolean) => {
				panel.hidden = !open;
				toggle.setAttribute("aria-expanded", String(open));
			};
			toggle.addEventListener("click", () => {
				if (phoneShare()) {
					share();
				} else {
					setOpen(panel.hidden);
					if (!panel.hidden) {
						panel.querySelector<HTMLElement>("a, button")?.focus();
					}
				}
			});
			document.addEventListener("click", (e) => {
				if (!panel.hidden && !bar.contains(e.target as Node)) {
					setOpen(false);
				}
			});
			bar.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && !panel.hidden) {
					setOpen(false);
					toggle.focus();
				}
			});
		}
		const copy = bar.querySelector<HTMLButtonElement>(".clip-share-copy")!;
		const status = bar.querySelector<HTMLElement>(".clip-share-status")!;
		copy.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(link);
				status.textContent = copy.dataset.copied!;
			} catch {
				prompt("", link);
			}
			setTimeout(() => (status.textContent = ""), 2000);
		});
	}
</script>

<style>
	.clip-share {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.5rem;
	}
	.clip-share-items {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
	}
	.clip-share-label,
	.clip-share-status {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.clip-share-label {
		margin-right: 0.15rem;
	}
	.clip-share-items a,
	.clip-share-items button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 50%;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s;
	}
	.clip-share-items a:hover,
	.clip-share-items a:focus-visible {
		color: var(--brand);
		border-color: var(--brand);
	}
	.clip-share-items button:hover,
	.clip-share-items button:focus-visible,
	.clip-share-toggle:hover,
	.clip-share-toggle:focus-visible,
	.clip-share-toggle[aria-expanded="true"] {
		color: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent);
	}
	/* Compact: one pill button; the buttons open in a small panel below it. */
	.clip-share-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2rem;
		padding: 0 0.8rem 0 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-xs);
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s;
	}
	.is-compact .clip-share-items {
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		z-index: 10;
		padding: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
		box-shadow: var(--sl-shadow-md);
	}
	.clip-share [hidden] {
		display: none;
	}
</style>
