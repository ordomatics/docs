---
// Share bar for the current page, on the editor tutorial pages only.
import ShareBar from "./ShareBar.astro";

interface Props {
	class?: string;
}
const { entry } = Astro.locals.starlightRoute;
const tutorial = /^(fr\/)?editeur(\/|$)/.test(entry.id);
const fr = entry.id.startsWith("fr/");
const link = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

{tutorial && (
	<div class:list={["page-share", Astro.props.class]}>
		<ShareBar link={link} title={entry.data.title} fr={fr} label={fr ? "Partager cette page" : "Share this page"} />
	</div>
)}
