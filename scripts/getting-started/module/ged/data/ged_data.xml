<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Everyone in the company files documents. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
    </record>

    <record id="access_group_staff" model="dms.access.group">
        <field name="name">Staff</field>
        <field name="perm_create">True</field>
        <field name="perm_write">True</field>
        <field name="perm_unlink">True</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="storage_documents" model="dms.storage">
        <field name="name">Documents</field>
        <field name="save_type">database</field>
    </record>

    <record id="directory_company" model="dms.directory">
        <field name="name">Company documents</field>
        <field name="is_root_directory">True</field>
        <field name="storage_id" ref="storage_documents"/>
        <field name="group_ids" eval="[(6, 0, [ref('access_group_staff')])]"/>
    </record>
</odoo>
